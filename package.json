{
  "name": "natours",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "license": "ISC",
  "author": "Pranav Sripada",
  "type": "commonjs",
  "main": "server.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "cross-env NODE_ENV=development nodemon server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "watch:js": "parcel watch ./public/js/index.js --dist-dir ./public/js/bundled",
    "build:js": "parcel build ./public/js/index.js --dist-dir ./public/js/bundled --no-cache",
    "postinstall": "npm run build:js"
  },
  "dependencies": {
    "assert": "^2.1.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-browserify": "^3.12.1",
    "dotenv": "^17.4.2",
    "events": "^3.3.0",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.1",
    "https-browserify": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "os-browserify": "^0.3.0",
    "parcel": "^2.16.4",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "pug": "^3.0.4",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "string_decoder": "^1.3.0",
    "stripe": "^22.5.0",
    "timers-browserify": "^2.0.12",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "validator": "^13.15.35",
    "vm-browserify": "^1.1.2",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.4"
  }
}
